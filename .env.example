# Advanced ASR config template; ordinary users run configure_asr.py setup once.
# The private user config is reused across projects; --env-file is an optional override.
# Never commit real values. Process environment variables take precedence.
# Literal KEY=VALUE only; no shell expansion, commands, or project-directory scanning.
# If manually creating a private file on POSIX, restrict its permissions to 600.
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-filetrans
DASHSCOPE_ASR_POLL_SECONDS=2
DASHSCOPE_ASR_TIMEOUT_SECONDS=3600
